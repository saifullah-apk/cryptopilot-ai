# Copy to .env for local development. Never commit .env.
# The key is read only by server/index.ts and sent to Gemini as a header.
GEMINI_API_KEY=
# Default when unset: gemini-3.5-flash (older 2.5-flash keys are being retired)
GEMINI_MODEL=gemini-3.5-flash
# API + static server port (Vite dev proxies /api here)
PORT=8787

# Database connection — MySQL / MariaDB
# Host and port come from your hosting database panel (not the app server).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
# Create/upgrade tables with: npm run db:init:mysql

# Embedded SQLite fallback (no credentials); used only when MySQL is not configured
PAPER_DB_PATH=data/paper.db
