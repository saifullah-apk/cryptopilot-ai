{
  "name": "cryptopilot-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --env-file-if-exists=.env server/index.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.mjs",
    "db:init:mysql": "node --env-file-if-exists=.env scripts/db-init-mysql.mjs",
    "build": "tsc --noEmit && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/server.mjs",
    "build:prod": "npm run build && npm run build:server",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/binance.test.ts tests/indicators.test.ts tests/coach.test.ts tests/paperTrading.test.ts tests/voice.test.ts tests/notifications.test.ts tests/analytics.test.ts tests/backtest.test.ts tests/portfolio.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
